---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import WeeklyComponent from "../components/Weekly.astro";

const weeklyPosts = await getCollection("weekly");
weeklyPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Weekly Notes" pageTitle="Weekly Notes" widthSize="max-w-screen-sm">
  <section>
    <ul>
      {weeklyPosts.map((post) => (
        <WeeklyComponent
          title={post.data.title}
          date={post.data.date}
          url={post.data.url}
          description={post.data.description}
        />
      ))}
    </ul>
  </section>
</Layout>
