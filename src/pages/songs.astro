---
import Song from './../components/Song.astro';
import Layout from "../layouts/Layout.astro";

import { getCollection } from "astro:content";

const allSongs = await getCollection("songs");

// Group songs by year listened
const songsByYear = allSongs.reduce((acc, song) => {
  const year = song.data.listenDate ? new Date(song.data.listenDate).getFullYear() : 'No Year';
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(song);
  return acc;
}, {} as Record<string, typeof allSongs>);

// Sort years in descending order (newest first)
const sortedYears = Object.keys(songsByYear).sort((a, b) => {
  if (a === 'No Year') return 1;
  if (b === 'No Year') return -1;
  return parseInt(b) - parseInt(a);
});

// Sort songs within each year by listen date (newest first)
sortedYears.forEach(year => {
  songsByYear[year].sort((a, b) => {
    const aListenDate = a.data.listenDate ? new Date(a.data.listenDate).getTime() : 0;
    const bListenDate = b.data.listenDate ? new Date(b.data.listenDate).getTime() : 0;
    return bListenDate - aListenDate;
  });
});
---

<Layout title="Songs" pageTitle="My Song Collection" widthSize="max-w-screen-sm">
  <section>
    <!-- Tabs -->
    <div class="flex flex-wrap gap-2 mb-8" id="year-tabs">
      {sortedYears.map((year) => (
        <button
          class="year-tab font-mono text-xs rounded bg-zinc-800 py-2 px-3 transition-all duration-200 ease-in-out hover:bg-zinc-700 relative shadow-md border border-white/10 hover:shadow-lg active:translate-y-0.5"
          data-year={year}
          data-active={year === sortedYears[0] ? 'true' : 'false'}
        >
          {year}
        </button>
      ))}
    </div>

    <!-- Songs by year -->
    {sortedYears.map((year) => (
      <div 
        class={`year-content ${year === sortedYears[0] ? 'block' : 'hidden'}`} 
        data-year={year}
      >
        {year === 'No Year' ? (
          <>
            <!-- Featured songs as cards (max 6) -->
            {songsByYear[year].filter(song => song.data.featured).slice(0, 6).length > 0 && (
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-6">
                {songsByYear[year].filter(song => song.data.featured).slice(0, 6).map((song) => (
                  <div class="flex justify-center sm:justify-start w-full max-w-[150px] mx-auto sm:mx-0">
                    <Song {...song.data} />
                  </div>
                ))}
              </div>
            )}
            
            <!-- Non-featured songs as list -->
            {songsByYear[year].filter(song => !song.data.featured).length > 0 && (
              <ul class="list-none p-0">
                {songsByYear[year].filter(song => !song.data.featured).map((song) => (
                  <li class="mb-4 border-b-2 border-gray-800 pb-2 transition duration-300 ease-in-out hover:text-neutral-400">
                    <div class="flex justify-between items-center text-sm">
                      <p>{song.data.title}</p>
                      <span class="font-mono capitalize">{song.data.artist} ~ {new Date(`${song.data.releaseDate}`).getFullYear()}</span>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : year === '2025' ? (
          <>
            <!-- Featured songs as cards (max 6) for 2025 -->
            {songsByYear[year].filter(song => song.data.featured).slice(0, 6).length > 0 && (
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-6">
                {songsByYear[year].filter(song => song.data.featured).slice(0, 6).map((song) => (
                  <div class="flex justify-center sm:justify-start w-full max-w-[150px] mx-auto sm:mx-0">
                    <Song {...song.data} />
                  </div>
                ))}
              </div>
            )}
            
            <!-- Non-featured songs as list for 2025 -->
            {songsByYear[year].filter(song => !song.data.featured).length > 0 && (
              <ul class="list-none p-0">
                {songsByYear[year].filter(song => !song.data.featured).map((song) => (
                  <li class="mb-4 border-b-2 border-gray-800 pb-2 transition duration-300 ease-in-out hover:text-neutral-400">
                    <div class="flex justify-between items-center text-sm">
                      <p>{song.data.title}</p>
                      <span class="font-mono capitalize">{song.data.artist} ~ {new Date(`${song.data.releaseDate}`).getFullYear()}</span>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <!-- All songs as cards for other years -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-6">
            {songsByYear[year].map((song) => (
              <div class="flex justify-center sm:justify-start w-full max-w-[150px] mx-auto sm:mx-0">
                <Song {...song.data} />
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>
</Layout>

<style>
  .year-tab[data-active="true"] {
    background: linear-gradient(145deg, #2a2a2a, #1a1a1a);
    box-shadow: 
      inset 2px 2px 4px rgba(0, 0, 0, 0.3),
      inset -2px -2px 4px rgba(255, 255, 255, 0.05),
      0 1px 2px rgba(0, 0, 0, 0.2);
    transform: translateY(1px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .year-tab:active:not([data-active="true"]) {
    box-shadow: 
      inset 2px 2px 4px rgba(0, 0, 0, 0.3),
      inset -2px -2px 4px rgba(255, 255, 255, 0.05);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('.year-tab');
    const contents = document.querySelectorAll('.year-content');

    tabs.forEach((tab) => {
      tab.addEventListener('click', (event) => {
        const target = event.target as HTMLButtonElement;
        const year = target.getAttribute('data-year');
        
        // Update active tab
        tabs.forEach((t) => {
          t.setAttribute('data-active', 'false');
        });
        target.setAttribute('data-active', 'true');
        
        // Show corresponding content
        contents.forEach((content) => {
          const contentElement = content as HTMLElement;
          if (contentElement.getAttribute('data-year') === year) {
            contentElement.classList.remove('hidden');
            contentElement.classList.add('block');
          } else {
            contentElement.classList.remove('block');
            contentElement.classList.add('hidden');
          }
        });
      });
    });
  });
</script>