---
interface Props {
	title: string;
	pageTitle: string;
	widthSize: string;
}

const { title, pageTitle, widthSize } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Custom CSS - Load before Tailwind to ensure proper precedence -->
		<link rel="stylesheet" href="/assets/custom.css">
		<!-- Include Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
		<!-- Preload custom fonts for better performance -->
		<!-- <link rel="preload" href="/assets/fonts/AppleGaramondWebfonts/AppleGaramond.woff2" as="font" type="font/woff2" crossorigin> -->
		<link rel="preload" href="/assets/fonts/AppleGaramondWebfonts/AppleGaramond-Light.woff2" as="font" type="font/woff2" crossorigin>
		<!-- <link rel="preload" href="/assets/fonts/AppleGaramondWebfonts/AppleGaramond-Bold.woff2" as="font" type="font/woff2" crossorigin> -->

	</head>
	<body class="dark-mode bg-oklch-16-8 text-gray-100 font-sans">
		<!-- Interactive Background Canvas - Always visible, but effects vary by page -->
		<canvas id="background-canvas" class="fixed inset-0 w-full h-full pointer-events-none z-0"></canvas>

		<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-oklch-16-8/70 overflow-auto">
			<nav class="mx-auto px-4 sm:px-6 lg:px-8">
				<div class="py-4">
					<button id="menu-toggle" class="md:hidden text-gray-100 mb-4">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
						</svg>
					</button>
					<div id="menu" class="hidden md:block">
						<div class="flex flex-col space-y-4 md:flex-row md:space-y-0 md:space-x-4 md:justify-between">
							<ul class="flex flex-col space-y-2 md:flex-row md:space-y-0 md:space-x-4">
								<li><a href="/" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">Home</a></li>
								<li><a href="/work" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">Work</a></li>
								<li><a href="/weekly" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">Weekly</a></li>
								<li><a href="/books" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">Books</a></li>
								<li><a href="/movies" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">Movies</a></li>
								<li><a href="/songs" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">Songs</a></li>
								<li><a href="/photos" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">Photos</a></li>
							</ul>
							<ul class="flex flex-col space-y-2 md:flex-row md:space-y-0 md:space-x-4">
								<li><a href="https://github.com/itsweliton" target="_blank" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">GitHub</a></li>
								<li><a href="https://www.instagram.com/welframes/" target="_blank" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">Instagram</a></li>
								<li><a href="https://www.linkedin.com/in/itsweliton/" target="_blank" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">LinkedIn</a></li>
								<li><a href="mailto:welitonderesende@gmail.com" class="hover:bg-gray-800 rounded px-2 py-1 text-sm text-nav-gray transition ease-in-out">Email</a></li>
							</ul>
						</div>
					</div>
				</div>
			</nav>
		</header>
		<main class={`${widthSize} m-auto mt-32 relative z-10`}>
			<h1 class="text-5xl text-white w-fit mb-4 font-apple-garamond-light">
				{pageTitle}
			</h1>
			<slot />
		</main>
		<footer class="text-center py-4 text-xs absolute bottom-0 w-full mt-10 relative z-2">
      <p>© 2014-2025 Weliton Soranzo. All Rights Reserved.</p>
			weliton.me . <span class="text-xs">v.2025.08</span>
    </footer>
	</body>
</html>

<script is:inline>
	// Menu functionality
	const menuToggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('menu');

	menuToggle.addEventListener('click', () => {
		menu.classList.toggle('hidden');
	});

	// Close menu when clicking outside
	document.addEventListener('click', (event) => {
		if (!menu.contains(event.target) && !menuToggle.contains(event.target)) {
			menu.classList.add('hidden');
		}
	});

	// Enable View Transitions API for slick page transitions
	if (document.startViewTransition) {
		// Intercept all navigation clicks
		document.addEventListener('click', (e) => {
			const link = e.target.closest('a');
			if (link && link.href && link.href.startsWith(window.location.origin) && !link.target && !e.ctrlKey && !e.metaKey) {
				e.preventDefault();
				
				document.startViewTransition(() => {
					window.location.href = link.href;
				});
			}
		});
	}

	// Interactive Background System - Always show dots, but effects vary by page
	class InteractiveBackground {
		constructor() {
			this.canvas = document.getElementById('background-canvas');
			if (!this.canvas) return; // Exit if no canvas
			
			this.ctx = this.canvas.getContext('2d');
			this.dots = [];
			this.mouse = { x: window.innerWidth / 2, y: window.innerHeight / 2 }; // Initialize to center
			this.animationId = null;
			this.isMouseActive = false; // Track if mouse has been active
			this.isBlackHoleActive = false; // Track if black hole is active
			this.glowOpacity = 0; // Track glow opacity for fade effect
			this.showEffects = false; // Will be set based on page type
			
			this.init();
		}

		init() {
			this.resizeCanvas();
			this.createDots();
			this.bindEvents();
			this.animate();
		}

		resizeCanvas() {
			this.canvas.width = window.innerWidth;
			this.canvas.height = window.innerHeight;
		}

		createDots() {
			const spacing = 32; // Double the spacing from 16 to 32 (half the dots)
			const cols = Math.ceil(this.canvas.width / spacing);
			const rows = Math.ceil(this.canvas.height / spacing);

			for (let i = 0; i < cols; i++) {
				for (let j = 0; j < rows; j++) {
					this.dots.push({
						x: i * spacing + spacing / 2,
						y: j * spacing + spacing / 2,
						originalX: i * spacing + spacing / 2,
						originalY: j * spacing + spacing / 2,
						vx: 0,
						vy: 0,
						mass: 1
					});
				}
			}
		}

		bindEvents() {
			window.addEventListener('resize', () => this.resizeCanvas());
			
			// Track mouse movement
			document.addEventListener('mousemove', (e) => {
				this.mouse.x = e.clientX;
				this.mouse.y = e.clientY;
				this.isMouseActive = true;
			});

			// Track touch movement for mobile
			document.addEventListener('touchmove', (e) => {
				e.preventDefault();
				const touch = e.touches[0];
				this.mouse.x = touch.clientX;
				this.mouse.y = touch.clientY;
				this.isMouseActive = true;
			});

			// Add mouse enter/leave events
			document.addEventListener('mouseenter', () => {
				this.isMouseActive = true;
			});

			document.addEventListener('mouseleave', () => {
				this.isMouseActive = false;
			});

			// Only add click events if effects are enabled
			if (this.showEffects) {
				// Add click event to toggle black hole on/off
				document.addEventListener('click', (e) => {
					// Only trigger animation if clicking on clean background
					// Check if the clicked element is an interactive element
					const target = e.target;
					const isInteractive = target.tagName === 'A' || 
						target.tagName === 'BUTTON' || 
						target.tagName === 'INPUT' || 
						target.tagName === 'IMG' || 
						target.tagName === 'H1' || 
						target.tagName === 'H2' || 
						target.tagName === 'H3' || 
						target.tagName === 'H4' || 
						target.tagName === 'H5' || 
						target.tagName === 'H6' || 
						target.tagName === 'P' || 
						target.tagName === 'SPAN' || 
						target.tagName === 'DIV' && target.classList.contains('interactive') ||
						target.closest('a') || 
						target.closest('button') || 
						target.closest('input') || 
						target.closest('img') ||
						target.closest('h1, h2, h3, h4, h5, h6, p, span');
					
					// Only trigger if clicking on clean background (not interactive elements)
					if (!isInteractive) {
						this.isBlackHoleActive = !this.isBlackHoleActive; // Toggle on/off
					}
				});

				// Add key event to deactivate black hole (ESC key)
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						this.isBlackHoleActive = false;
					}
				});
			}
		}

		updateDots() {
			// Only apply black hole effects if enabled
			if (this.showEffects) {
				const gravityStrength = 30; // Back to 1.5 for proper orbital attraction
				const maxDistance = 300; // Extended area of effect
				const damping = 0.40; // Back to 0.98 for slower movement
				const springStrength = 0.08; // Reduced spring strength from 0.15 to 0.08 (gentler return)
				const blackHoleRadius = 12.5; // Visual black hole size
				const orbitalRadius = 30; // Area where dots actually orbit

				// Fade glow opacity smoothly
				if (this.isBlackHoleActive) {
					this.glowOpacity = Math.min(1, this.glowOpacity + 0.05); // Fade in
				} else {
					this.glowOpacity = Math.max(0, this.glowOpacity - 0.05); // Fade out
				}

				this.dots.forEach(dot => {
					// Only apply black hole effect if black hole is active AND mouse has been active AND glow is visible
					if (this.isBlackHoleActive && this.isMouseActive && this.glowOpacity > 0.1) {
						// Vector from dot to mouse (black hole center)
						const dx = this.mouse.x - dot.x;
						const dy = this.mouse.y - dot.y;
						const distance = Math.sqrt(dx * dx + dy * dy);

						// Apply gravitational attraction to ALL dots within radius
						if (distance < maxDistance) {
							// Calculate distance from orbital area edge (not black hole center)
							const distanceFromOrbit = Math.max(0, distance - orbitalRadius);
							
							// Stronger force for dots closer to the orbital area
							const force = gravityStrength / (distanceFromOrbit + 1); // +1 to avoid division by zero
							
							// Calculate perpendicular force for orbital motion
							// Instead of pulling directly toward center, create tangential velocity
							const angle = Math.atan2(dy, dx);
							const perpendicularAngle = angle + Math.PI / 2; // 90 degrees perpendicular
							
							// Apply force perpendicular to the radial direction (creates orbit)
							dot.vx += Math.cos(perpendicularAngle) * force;
							dot.vy += Math.sin(perpendicularAngle) * force;
							
							// Add slight radial attraction to keep particles in orbit
							const radialForce = force * 0.3; // Weaker radial component
							dot.vx += (dx / distance) * radialForce;
							dot.vy += (dy / distance) * radialForce;
						}
					}

					// Spring force to return to grid position
					const springDx = dot.originalX - dot.x;
					const springDy = dot.originalY - dot.y;
					dot.vx += springDx * springStrength;
					dot.vy += springDy * springStrength;

					// Apply damping
					dot.vx *= damping;
					dot.vy *= damping;

					// Update position
					dot.x += dot.vx;
					dot.y += dot.vy;
				});
			} else {
				// On other pages, just keep dots in static grid
				this.dots.forEach(dot => {
					// Reset to original position
					dot.x = dot.originalX;
					dot.y = dot.originalY;
					dot.vx = 0;
					dot.vy = 0;
				});
			}
		}

		drawDots() {
			this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
			
			// Draw dots with fade effect based on black hole state
			this.dots.forEach(dot => {
				if (this.showEffects && this.isBlackHoleActive && this.glowOpacity > 0) {
					// Active state: bright white core with blue glow (faded in)
					// Outer blue glow
					this.ctx.fillStyle = '#3B82F6'; // blue-500
					this.ctx.globalAlpha = 0.2 * this.glowOpacity;
					this.ctx.beginPath();
					this.ctx.arc(dot.x, dot.y, 4, 0, Math.PI * 2);
					this.ctx.fill();
					
					// Middle blue glow
					this.ctx.fillStyle = '#60A5FA'; // blue-400
					this.ctx.globalAlpha = 0.3 * this.glowOpacity;
					this.ctx.beginPath();
					this.ctx.arc(dot.x, dot.y, 2.5, 0, Math.PI * 2);
					this.ctx.fill();
					
					// Bright white core
					this.ctx.fillStyle = '#FFFFFF'; // pure white
					this.ctx.globalAlpha = 0.9 * this.glowOpacity;
					this.ctx.beginPath();
					this.ctx.arc(dot.x, dot.y, 1, 0, Math.PI * 2);
					this.ctx.fill();
				} else {
					// Inactive state: no glow, just simple dots
					this.ctx.fillStyle = '#6B7280'; // medium gray
					this.ctx.globalAlpha = 0.6;
					this.ctx.beginPath();
					this.ctx.arc(dot.x, dot.y, 1, 0, Math.PI * 2);
					this.ctx.fill();
				}
			});

			// Draw black hole visualization only when active and faded in
			if (this.showEffects && this.isBlackHoleActive && this.isMouseActive && this.glowOpacity > 0) {
				// Create realistic event horizon glow effect based on actual black hole images
				
				// Outer accretion disk glow (orange-red, like real black holes)
				const gradient1 = this.ctx.createRadialGradient(
					this.mouse.x, this.mouse.y, 12.5,
					this.mouse.x, this.mouse.y, 25
				);
				gradient1.addColorStop(0, `rgba(255, 69, 0, ${0.1 * this.glowOpacity})`); // Orange-red
				gradient1.addColorStop(0.5, `rgba(255, 140, 0, ${0.05 * this.glowOpacity})`); // Dark orange
				gradient1.addColorStop(1, 'rgba(255, 69, 0, 0)'); // Transparent
				
				this.ctx.fillStyle = gradient1;
				this.ctx.beginPath();
				this.ctx.arc(this.mouse.x, this.mouse.y, 25, 0, Math.PI * 2);
				this.ctx.fill();
				
				// Middle accretion disk (brighter orange)
				const gradient2 = this.ctx.createRadialGradient(
					this.mouse.x, this.mouse.y, 12.5,
					this.mouse.x, this.mouse.y, 20
				);
				gradient2.addColorStop(0, `rgba(255, 150, 10, ${0.2 * this.glowOpacity})`); // Brighter orange
				gradient2.addColorStop(0.7, `rgba(255, 140, 0, ${0.1 * this.glowOpacity})`); // Medium orange
				gradient2.addColorStop(1, 'rgba(255, 69, 0, 0)'); // Transparent
				
				this.ctx.fillStyle = gradient2;
				this.ctx.beginPath();
				this.ctx.arc(this.mouse.x, this.mouse.y, 20, 0, Math.PI * 2);
				this.ctx.fill();
				
				// Inner event horizon glow (bright orange)
				const gradient3 = this.ctx.createRadialGradient(
					this.mouse.x, this.mouse.y, 12.5,
					this.mouse.x, this.mouse.y, 18
				);
				gradient3.addColorStop(0, `rgba(255, 150, 10, ${0.4 * this.glowOpacity})`); // Bright orange
				gradient3.addColorStop(0.8, `rgba(255, 140, 0, ${0.2 * this.glowOpacity})`); // Medium orange
				gradient3.addColorStop(1, 'rgba(255, 69, 0, 0)'); // Transparent
				
				this.ctx.fillStyle = gradient3;
				this.ctx.beginPath();
				this.ctx.arc(this.mouse.x, this.mouse.y, 18, 0, Math.PI * 2);
				this.ctx.fill();
				
				// Pure black event horizon (the actual black hole)
				this.ctx.fillStyle = '#000000';
				this.ctx.globalAlpha = this.glowOpacity;
				this.ctx.beginPath();
				this.ctx.arc(this.mouse.x, this.mouse.y, 12.5, 0, Math.PI * 2);
				this.ctx.fill();
			}
		}

		animate() {
			this.updateDots();
			this.drawDots();
			this.animationId = requestAnimationFrame(() => this.animate());
		}

		destroy() {
			if (this.animationId) {
				cancelAnimationFrame(this.animationId);
			}
		}
	}

	// Initialize the interactive background when the page loads
	document.addEventListener('DOMContentLoaded', () => {
		const background = new InteractiveBackground();
		
		// Check if this page should show effects (index page)
		// We'll check for a data attribute or specific page content
		const isIndexPage = document.querySelector('main h1')?.textContent?.includes('Hey! It\'s Weliton');
		if (isIndexPage) {
			background.showEffects = true;
		}
	});
</script>